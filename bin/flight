#!/usr/bin/env bash

set -eu

# Environment
export FLIGHT_CONFIG_DIR=$HOME/.config/flight
export FLIGHT_CERTS_DIR=$FLIGHT_CONFIG_DIR/certs
export FLIGHT_ENV_FILE=$FLIGHT_CONFIG_DIR/.env
export FLIGHT_SSL_KEY_FILE=$FLIGHT_CERTS_DIR/ssl.key
export FLIGHT_SSL_CRT_FILE=$FLIGHT_CERTS_DIR/ssl.crt

if [ -f "$FLIGHT_ENV_FILE" ]; then
  # shellcheck disable=SC1090
  source "$FLIGHT_ENV_FILE"
fi

# Config
export FLIGHT_DOMAIN=${FLIGHT_DOMAIN:-flght.dev}

function flight_mkcert() {
  if grep -qi microsoft /proc/sys/kernel/osrelease; then
    MKCERT="mkcert.exe"
  else
    MKCERT="mkcert"
  fi

  mkdir -p "$FLIGHT_CERTS_DIR"

  $MKCERT -install -key-file="$FLIGHT_SSL_KEY_FILE" \
    -cert-file="$FLIGHT_SSL_CRT_FILE" \
    "*.${FLIGHT_DOMAIN}" > /dev/null
}

function flight_compose() {
  docker compose -f https://github.com/sitepilot/flight-bash.git#2.x --env-file "$FLIGHT_ENV_FILE" "$@"
}

function flight_up() {
  if [ ! -f "$FLIGHT_SSL_KEY_FILE" ] || [ ! -f "$FLIGHT_SSL_CRT_FILE" ]; then
    mkcert
  fi

  flight_compose up -d
}

function flight_down() {
  flight_compose down --remove-orphans
}

function fight_restart() {
  flight_compose up -d --remove-orphans --force-recreate
}

case ${1:-} in
  up)
    flight_up
    ;;
  down)
    flight_down
    ;;
  secure)
    flight_mkcert
    flight_restart
    ;;
  *)
    flight_compose "$@"
    ;;
esac
